# Taillight environment configuration
#
# Copy this file to .env and adjust values for your environment.
# Docker Compose reads .env automatically from the project root.
#
# This file holds per-deployment settings (passwords, ports, feature toggles).
# Application tuning (retention, notifications, SMTP, etc.) lives in api/config.yml.

# --- PostgreSQL ---
# Used by the postgres container AND by the API + rsyslog to connect.
POSTGRES_PASSWORD=taillight

# Bind address for the PostgreSQL host port.
# Format: "<bind-address>:<host-port>"
# Default binds to loopback only. Set to 0.0.0.0:5432 for remote access.
POSTGRES_BIND=127.0.0.1:15432

# --- Host ports ---
# Control how you reach services from the host machine.
# Container-to-container communication always uses internal ports.
API_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Host ports for syslog ingestion (UDP + TCP).
# Netlog: network device syslog (Juniper, Cisco, Arista).
# Srvlog: server syslog (Linux, Docker, PostgreSQL).
# Default 1514/1515 for development; set to 514/515 in production.
RSYSLOG_NETLOG_PORT=1514
RSYSLOG_SRVLOG_PORT=1515

# --- API settings ---
# Log level: debug, info, warn, error.
LOG_LEVEL=info

# Enable authentication (login, sessions, API keys).
# Set to false for deployments behind a firewall where all users should have access.
AUTH_ENABLED=true

# Trusted single-IP header your reverse proxy sets, used to resolve the real
# client IP. Empty = trust only the TCP peer (safe when exposed directly).
# Set to X-Real-IP when running behind the nginx reverse proxy; leaving it empty
# behind a proxy makes every client appear as the proxy's IP.
REAL_IP_HEADER=

# --- OTLP log export ---
# Version baked into the API image, reported as the OTLP service.version.
# Set it to the commit you build: TAILLIGHT_VERSION=$(git rev-parse --short HEAD).
TAILLIGHT_VERSION=
# Export taillight's own logs over OTLP/HTTP, beside the console and the log
# shipper. Empty = off. The address must be reachable from inside the
# container, e.g. a collector bound to the compose network's gateway.
OTEL_EXPORTER_OTLP_ENDPOINT=
# service.name on exported records (default taillight).
OTEL_SERVICE_NAME=
# Extra resource attributes. Without host.name every container reports
# taillight-api: host.name=syslog-01,deployment.environment.name=prod
OTEL_RESOURCE_ATTRIBUTES=
# Minimum level exported: debug, info, warn, error (default info).
OTLP_MIN_LEVEL=

# --- Frontend ---
# Leave empty for same-origin proxy mode (nginx routes /api to the backend).
# Set to http://localhost:8080 for local dev without a reverse proxy.
API_URL=
