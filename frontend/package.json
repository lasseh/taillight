{
  "name": "taillight-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "NODE_OPTIONS=--disable-warning=DEP0205 vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=DEP0205 vitest",
    "coverage": "NODE_OPTIONS=--disable-warning=DEP0205 vitest run --coverage",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "dompurify": "^3.4.14",
    "focus-trap": "^8.2.2",
    "marked": "^18.0.11",
    "pinia": "^4.0.3",
    "prismjs": "^1.30.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/prismjs": "^1.26.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "glob": "^13.0.0",
    "js-cookie": ">=3.0.6",
    "brace-expansion@^2.0.0": "^2.1.4",
    "brace-expansion@^5.0.0": "^5.0.7"
  }
}
